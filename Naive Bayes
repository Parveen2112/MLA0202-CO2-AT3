import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.feature_extraction.text import CountVectorizer
from sklearn.naive_bayes import MultinomialNB
from sklearn.metrics import accuracy_score,confusion_matrix,classification_report
data={'text':['free prize winner','free offer click','win free money','free lottery winner','special lottery offer','claim your free prize','win lottery money','free cash offer','urgent win prize','lottery winner claim','hello how are you','meeting at ten today','please send the report','can you call me','project meeting tomorrow','let us discuss the project','please attend the meeting','send me the document','how was your day','see you tomorrow'],'label':['spam','spam','spam','spam','spam','spam','spam','spam','spam','spam','ham','ham','ham','ham','ham','ham','ham','ham','ham','ham']}
df=pd.DataFrame(data)
print("DATASET")
print(df.head())
df['label']=df['label'].map({'ham':0,'spam':1})
X_train,X_test,y_train,y_test=train_test_split(df['text'],df['label'],test_size=0.30,random_state=42,stratify=df['label'])
vectorizer=CountVectorizer()
X_train_count=vectorizer.fit_transform(X_train)
X_test_count=vectorizer.transform(X_test)
print("\nNumber of Features:",len(vectorizer.get_feature_names_out()))
model_without=MultinomialNB(alpha=0)
model_without.fit(X_train_count,y_train)
prediction_without=model_without.predict(X_test_count)
accuracy_without=accuracy_score(y_test,prediction_without)
print("\nWITHOUT LAPLACE SMOOTHING")
print("Accuracy:",round(accuracy_without*100,2),"%")
print("\nClassification Report:")
print(classification_report(y_test,prediction_without,target_names=['Ham','Spam'],zero_division=0))
cm_without=confusion_matrix(y_test,prediction_without)
print("Confusion Matrix:")
print(cm_without)
model_with=MultinomialNB(alpha=1)
model_with.fit(X_train_count,y_train)
prediction_with=model_with.predict(X_test_count)
accuracy_with=accuracy_score(y_test,prediction_with)
print("\nWITH LAPLACE SMOOTHING")
print("Accuracy:",round(accuracy_with*100,2),"%")
print("\nClassification Report:")
print(classification_report(y_test,prediction_with,target_names=['Ham','Spam'],zero_division=0))
cm_with=confusion_matrix(y_test,prediction_with)
print("Confusion Matrix:")
print(cm_with)
models=['Without\nSmoothing','With Laplace\nSmoothing']
accuracies=[accuracy_without*100,accuracy_with*100]
plt.figure(figsize=(7,5))
bars=plt.bar(models,accuracies)
plt.title('Naive Bayes Accuracy Comparison')
plt.ylabel('Accuracy (%)')
plt.ylim(0,110)
for bar in bars:
    height=bar.get_height()
    plt.text(bar.get_x()+bar.get_width()/2,height+2,f'{height:.2f}%',ha='center')
plt.show()
fig,axes=plt.subplots(1,2,figsize=(10,4))
axes[0].imshow(cm_without)
axes[0].set_title('Without Laplace Smoothing')
axes[0].set_xlabel('Predicted')
axes[0].set_ylabel('Actual')
axes[0].set_xticks([0,1])
axes[0].set_yticks([0,1])
axes[0].set_xticklabels(['Ham','Spam'])
axes[0].set_yticklabels(['Ham','Spam'])
for i in range(2):
    for j in range(2):
        axes[0].text(j,i,cm_without[i,j],ha='center',va='center')
axes[1].imshow(cm_with)
axes[1].set_title('With Laplace Smoothing')
axes[1].set_xlabel('Predicted')
axes[1].set_ylabel('Actual')
axes[1].set_xticks([0,1])
axes[1].set_yticks([0,1])
axes[1].set_xticklabels(['Ham','Spam'])
axes[1].set_yticklabels(['Ham','Spam'])
for i in range(2):
    for j in range(2):
        axes[1].text(j,i,cm_with[i,j],ha='center',va='center')
plt.tight_layout()
plt.show()
print("\nFINAL COMPARISON")
print("Accuracy without smoothing:",round(accuracy_without*100,2),"%")
print("Accuracy with Laplace smoothing:",round(accuracy_with*100,2),"%")
print("\nLaplace smoothing prevents zero probabilities by assigning a small probability to unseen words.")
